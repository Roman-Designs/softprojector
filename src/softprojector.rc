#include <winver.h>
#include "headers/version.hpp"

IDI_ICON1 ICON DISCARDABLE "softprojector.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SOFTPROJECTOR_VERSION_WINDOWS
 PRODUCTVERSION SOFTPROJECTOR_VERSION_WINDOWS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SoftProjector " SOFTPROJECTOR_VERSION_LABEL "\0"
            VALUE "FileVersion", SOFTPROJECTOR_VERSION "\0"
            VALUE "InternalName", "SoftProjector\0"
            VALUE "OriginalFilename", "SoftProjector.exe\0"
            VALUE "ProductName", "SoftProjector\0"
            VALUE "ProductVersion", SOFTPROJECTOR_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
